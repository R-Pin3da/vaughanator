{
  "name": "vaughanator",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación local para preparar y publicar audios Vaughan en iVoox",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder && node verify-windows-signature.cjs",
    "dist:linux": "node build-linux.cjs",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "volta": {
    "node": "24.22.2",
    "npm": "11.9.0"
  },
  "build": {
    "appId": "com.vaughanator.desktop",
    "productName": "Vaughanator",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "forceCodeSigning": true,
      "target": "portable"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": ["dmg"],
      "category": "public.app-category.music"
    }
  }
}
